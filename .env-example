OPENAI_API_KEY=...
OBSIDIAN_VAULT_PATH=/absolute/path/to/obsidian/vault
HERMES_ENABLE_PROJECT_PLUGINS=true

# Telegram (optional; needed for cron delivery to chat)
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_ALLOWED_USERS=...
# TELEGRAM_HOME_CHANNEL=...

# Dedicated calendar the morning brief writes its plan blocks to.
# Create a calendar named "Athena" in Google Calendar, then copy its Calendar ID
# from Settings -> <calendar> -> Integrate calendar. Never point this at "primary".
# ATHENA_CALENDAR_ID=...@group.calendar.google.com
