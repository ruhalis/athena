# Keys shared by every target. Chip-specific keys (flash size, PSRAM) live in
# sdkconfig.defaults.<target>, which ESP-IDF layers on top of this file after
# `idf.py set-target <chip>`.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The panel is refreshed by a tight GPIO loop; -O2 keeps its pixel clock high.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# The hub75 refresh task owns core 1 and never blocks, so the idle task on that
# core never runs. Do not let the task watchdog treat that as a hang.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Wi-Fi is the second transport (main/net.c, firmware/components/athena_common).
# The Wi-Fi stack roughly quadruples the binary, so use the 1.5 MB factory
# partition; it fits the WROOM's 4 MB flash and the S3's 16 MB alike.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Core 1 is the panel's: keep every network task on core 0.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# The audio stream (main/audio.c) pushes 32 kB/s through one TCP socket, and
# lwIP caps a socket's throughput near send buffer / round-trip time: the
# default 5760 bytes (4 MSS) fall short on a Wi-Fi link with 100-300 ms
# spikes. 12 MSS each way; the memory is used only while data is in flight.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=17280
CONFIG_LWIP_TCP_WND_DEFAULT=17280
