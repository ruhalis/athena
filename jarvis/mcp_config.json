{
  "mcpServers": {
    "jarvis": {
      "command": "/Users/ruhalis/projects/jarvis/.venv/bin/python",
      "args": ["/Users/ruhalis/projects/jarvis/jarvis/services/jarvis_mcp_server.py"]
    },
    "obsidian": {
      "command": "uvx",
      "args": ["mcp-obsidian"]
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp",
        "--header",
        "Authorization: Bearer ${LINEAR_API_KEY}"
      ]
    }
  }
}
